CUT3R
CLAUDE.md
boxmot

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
build/
dist/
.ipynb_checkpoints/

# Model weights, auto-downloaded on first run
models/
*.pt
*.pth
*.onnx
*.engine
