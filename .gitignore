docs/*_Project_Tracker.xlsx
docs/.~lock.*_Project_Tracker.xlsx#
*.bak
# Dataset root: symlinks into machine-specific download locations and derived
# views built from them. Only the layout doc is tracked; see data/README.md.
data/*
!data/README.md
CUT3R
boxmot

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
build/
dist/
.ipynb_checkpoints/

# Model weights, auto-downloaded on first run
models/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite

# Experiment outputs
lab/outputs/
outputs/

# Run directories: manifest.json and metrics.json are small and tracked, so a
# result stays reproducible from its commit. The heavy artifacts are not.
runs/*/artifacts/
*.mp4
*.avi
*.mkv
*.mov
*.webm
*.npy
*.npz
*.ply
*.pcd
*.pkl
*.log

# Overlays and figures written beside the code
*.png
*.jpg
*.jpeg

tmp
docs/paper
docs/slides
# Stray output from backgrounded runs
nohup.out
